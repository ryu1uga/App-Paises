{
  "name": "atlas-quest",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "prebuild": "expo prebuild --clean",
    "build:preview": "eas build --profile preview --platform android",
    "build:preview:local": "eas build --profile preview --platform android --local",
    "build:dev": "eas build --profile development --platform android",
    "apk:local": "expo run:android --variant release",
    "doctor": "npx expo-doctor",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/outfit": "^0.4.3",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.12",
    "expo-blur": "~57.0.2",
    "expo-constants": "~57.0.10",
    "expo-dev-client": "~57.0.11",
    "expo-font": "~57.0.1",
    "expo-gl": "~57.0.2",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.2",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.5",
    "expo-router": "~57.0.12",
    "expo-splash-screen": "~57.0.6",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1",
    "three": "^0.185.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.0",
    "@types/three": "^0.185.0",
    "babel-preset-expo": "~57.0.6",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.4",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.ts"
    ],
    "testMatch": [
      "<rootDir>/tests/**/*.test.ts"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "collectCoverageFrom": [
      "src/lib/**/*.ts",
      "src/store/**/*.ts",
      "src/data/countries.ts"
    ]
  }
}
